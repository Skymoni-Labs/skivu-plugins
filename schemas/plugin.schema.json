{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skivu draft prompt pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "permissions",
    "description",
    "repository",
    "kind",
    "entry"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "permissions": {
      "type": "array",
      "maxItems": 0
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "pattern": "^https://[^\\s/?#@]+(?:/[^\\s?#]*)?$"
    },
    "kind": {
      "const": "prompt-pack"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    }
  }
}
