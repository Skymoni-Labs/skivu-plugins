{
  "schemaVersion": 1,
  "apiVersion": "1.0",
  "id": "org.skivu.pocket-phone",
  "name": "角色小手机",
  "version": "1.1.0",
  "minHostVersion": "0.2.38",
  "author": "Skivu contributors",
  "description": "独立小手机：21 个生活应用，按角色保存记录，支持原版存档导入、结构化角色任务、用户自选的音乐与生图服务。",
  "license": "GPL-3.0-only",
  "source": "https://github.com/skyjjgw/skivu-plugins/tree/main/plugins/pocket-phone",
  "entry": "index.html",
  "permissions": ["storage", "files", "secrets", "network", "network.local", "ai.generate", "chat.read", "chat.write"],
  "networkDomains": ["*"],
  "contributes": {
    "launcher": true,
    "chatSurface": true,
    "chatActions": [
      {"id": "open-phone", "title": "打开角色小手机"},
      {"id": "update-phone", "title": "更新角色的小手机"},
      {"id": "chat-phone", "title": "与角色聊天并使用小手机"}
    ]
  }
}
