        "description": "在手机上运行 DeepSeek Harness：对话、编程、项目文件与经授权的手机操作。",
        "license": "GPL-3.0-only",
        "source": "https://github.com/skyjjgw/skivu-dsh-runtime",
        "entry": "index.html",
        "permissions": [
          "runtime.local",
          "ai.generate",
          "device.observe",
          "device.control",
          "agent.tasks"
        ],
        "networkDomains": [],
        "contributes": {
          "launcher": true,
          "chatActions": []
        }
      },
      "url": "https://skymoni.com/app-plugins/web-packages/a457611eb2d38884f0bf379c89253407055cc8ad85b0c007729a5aa1d1870ab5.json",
      "sha256": "a457611eb2d38884f0bf379c89253407055cc8ad85b0c007729a5aa1d1870ab5",
      "bytes": 41040
    }
  ]
}
